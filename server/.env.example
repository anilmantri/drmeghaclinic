# Copy this file to .env for local development (never commit the real .env)

# "anthropic" or "gemini" — selects which vision API /api/scan uses.
# Note: Gemini free vs paid tier is controlled by billing on the Google Cloud
# project behind GEMINI_API_KEY, not by this app.
AI_PROVIDER=gemini

# Anthropic API key — server-side only, never expose to the browser
# Required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Google Gemini API key (from aistudio.google.com) — required when AI_PROVIDER=gemini
GEMINI_API_KEY=xxxxxxxx

# Postgres connection string — Render provides this automatically when you
# link a Render PostgreSQL database to this service (as an Environment Group
# or "Add Database" in the dashboard). For local dev, point to a local Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/drmegha_leads

# Your live site's origin — locks down CORS. Use * only for local testing.
ALLOWED_ORIGIN=https://drmegha.in

# A strong random string of your choosing — protects GET /api/leads
ADMIN_KEY=change-me-to-a-long-random-string

# Optional — your existing Web3Forms access key, for email notifications
WEB3FORMS_KEY=

# Render sets PORT automatically in production; only needed for local dev
PORT=3000
